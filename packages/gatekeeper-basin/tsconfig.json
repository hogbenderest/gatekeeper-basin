{
  "extends": "../../cloudflare-os/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The configurator UI modules are JSX (rendered with h(), the sandboxed runtime's factory).
    "jsx": "react",
    "jsxFactory": "h",
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src", "__tests__"],
  "exclude": ["dist", "node_modules", ".wrangler"]
}
